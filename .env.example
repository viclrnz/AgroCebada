# ==================================================
# AgroCebada - plantilla de variables de entorno
# Copia este archivo como ".env" y llena los valores.
# NUNCA subas el ".env" real al repositorio.
# Si un valor tiene simbolos (# $ %), ponlo entre comillas simples.
# CORREGIDO: ahora cada variable de aquí es exactamente la que lee settings.py / services.py.
# ==================================================

# --- Django ---
# OBLIGATORIA. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# True solo en tu equipo local. En produccion debe ser False (o no ponerla).
DJANGO_DEBUG=False
# Dominios del backend separados por comas, sin http://
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del panel de administracion (termina en /). Cambiala en produccion.
DJANGO_ADMIN_URL=admin/
# True si el backend corre detras del proxy de un hosting (Render, Railway...). Sirve para leer la IP real.
DJANGO_DETRAS_DE_PROXY=False
# Segundos que el navegador recuerda usar HTTPS (solo con DEBUG=False).
DJANGO_HSTS_SECONDS=3600

# --- Base de datos (Supabase) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# --- Usuario de SOLO LECTURA para el chatbot (rol chatbot_lector, sql/007_rol_chatbot.sql) ---
# CORREGIDO: antes se llamaban DB_RO_USER / DB_RO_PASSWORD, pero settings.py lee estos nombres.
# Con el pooler de Supabase: chatbot_lector.<id_proyecto>
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
# CORREGIDO: antes "default". En produccion el chatbot SOLO funciona con "readonly".
# "default" (usuario principal) solo se acepta con DJANGO_DEBUG=True, para pruebas locales.
CHATBOT_DB_ALIAS=readonly

# --- Chatbot (API de Meganova) ---
SINOX_API_KEY=
CHATBOT_MODEL=
# Opcional: direccion del proveedor de IA (por defecto https://api.meganova.ai/v1)
CHATBOT_API_URL=
# Mensajes permitidos por IP en cada ventana de tiempo (segundos)
CHATBOT_LIMITE_MENSAJES=20
CHATBOT_LIMITE_VENTANA_S=600
# DEBUG para ver en consola cada consulta que hace la IA y su resultado
CHATBOT_LOG_LEVEL=INFO

# --- CORS / CSRF (direccion del FRONTEND, con http/https y puerto, separadas por comas) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Opcional: si no se pone, se usan los mismos origenes de CORS_ALLOWED_ORIGINS
CSRF_TRUSTED_ORIGINS=
