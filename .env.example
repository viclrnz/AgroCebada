# ==================================================
# AgroCebada - plantilla de variables de entorno
# Copia este archivo como ".env" y llena los valores.
# NUNCA subas el ".env" real al repositorio.
# Si un valor tiene simbolos (# $ %), ponlo entre comillas simples.
# ==================================================

# --- Django ---
DJANGO_SECRET_KEY=
# True solo en tu equipo local. En produccion debe ser False.
DJANGO_DEBUG=False
# Dominios del backend separados por comas, sin http://
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (Supabase) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# --- Usuario de SOLO LECTURA para el chatbot (opcional hasta que exista el rol en Supabase) ---
DB_RO_USER=
DB_RO_PASSWORD=

# --- Chatbot (API de Meganova) ---
SINOX_API_KEY=
CHATBOT_MODEL=
# default = conexion normal; readonly = usuario de solo lectura (requiere DB_RO_USER)
CHATBOT_DB_ALIAS=default

# --- CORS / CSRF (direccion del FRONTEND, con http/https y puerto, separadas por comas) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
